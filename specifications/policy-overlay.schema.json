{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doa-standard.org/schemas/policy-overlay.schema.json",
  "title": "DOA PolicyOverlay (epigenome)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "base_genome_digest",
    "precedence",
    "scope",
    "issuer",
    "reason",
    "issued_at",
    "expires_at",
    "effect",
    "signature_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "base_genome_digest": {
      "type": "string",
      "pattern": "^sha(256|384|512):[A-Fa-f0-9]+$"
    },
    "precedence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changes"
      ],
      "properties": {
        "changes": {
          "type": "object",
          "minProperties": 1
        },
        "increases_authority": {
          "const": false
        }
      }
    },
    "signature_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
