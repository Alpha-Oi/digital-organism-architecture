{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doa-standard.org/schemas/verification-report.schema.json",
  "title": "DOA Verification Report",
  "description": "Informative contract of the Verification Kit: outcomes of one run of verification/conformance-test-plan.yaml and verification/fault-scenarios.yaml. Its use is optional; it never replaces a conformance claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "plan_version",
    "implementation",
    "version",
    "run_id",
    "run_date",
    "executor",
    "environment",
    "results"
  ],
  "properties": {
    "standard": {
      "const": "DOA-FS-1.0"
    },
    "plan_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "implementation": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Value of the telemetry attribute doa.verification.run.id for this run."
    },
    "run_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "executor": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/environment_type"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/result",
        "required": [
          "case"
        ]
      }
    },
    "scenario_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result",
        "required": [
          "scenario"
        ]
      }
    }
  },
  "$defs": {
    "environment_type": {
      "description": "Verification is never run against production: only isolated and staging environments are expressible.",
      "enum": [
        "isolated",
        "staging"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case": {
          "type": "string",
          "pattern": "^TC-(CORE|DIST|ADPT|EMB|COND)-[0-9]{2}-[0-9]{2}$"
        },
        "scenario": {
          "type": "string",
          "pattern": "^FS-(CELL|ORGAN|CIRC|ORG)-[0-9]{2}$"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "SKIPPED"
          ]
        },
        "environment_type": {
          "$ref": "#/$defs/environment_type",
          "description": "Overrides environment.type for this result."
        },
        "executed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "oneOf": [
        {
          "required": [
            "case"
          ],
          "not": {
            "required": [
              "scenario"
            ]
          }
        },
        {
          "required": [
            "scenario"
          ],
          "not": {
            "required": [
              "case"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "BLOCKED",
                  "SKIPPED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "justification"
            ]
          }
        }
      ]
    }
  }
}
