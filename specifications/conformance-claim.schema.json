{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doa-standard.org/schemas/conformance-claim.schema.json",
  "title": "DOA Conformance Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "implementation",
    "owner",
    "version",
    "assessment_date",
    "status",
    "assurance",
    "profiles",
    "scope",
    "requirements",
    "assessor"
  ],
  "properties": {
    "standard": {
      "const": "DOA-FS-1.0"
    },
    "implementation": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "assessment_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "enum": [
        "UNVERIFIED",
        "PARTIAL",
        "VERIFIED"
      ]
    },
    "assurance": {
      "enum": [
        "self-assessed",
        "independently-reviewed"
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Core",
          "Distributed",
          "Adaptive",
          "Embodied"
        ]
      }
    },
    "conditional": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "reproduction",
          "federation",
          "horizontal-transfer"
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary",
        "environments"
      ],
      "properties": {
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-(CORE|DIST|ADPT|EMB|COND)-[0-9]{2}$"
          },
          "status": {
            "enum": [
              "PASS",
              "PARTIAL",
              "FAIL",
              "EXCLUDED",
              "NOT_ASSESSED"
            ]
          },
          "component": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "justification": {
            "type": "string",
            "minLength": 1
          },
          "gap_owner": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            },
            "then": {
              "required": [
                "evidence_ref"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "EXCLUDED"
                }
              }
            },
            "then": {
              "required": [
                "justification"
              ]
            }
          }
        ]
      }
    },
    "assessor": {
      "type": "string",
      "minLength": 1
    },
    "blocking_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepted_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reassessment": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "VERIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "requirements": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "EXCLUDED"
                  ]
                }
              }
            }
          },
          "blocking_gaps": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
