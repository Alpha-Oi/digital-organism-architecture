{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doa-standard.org/schemas/health-evidence.schema.json",
  "title": "DOA HealthEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "startup",
    "readiness",
    "liveness",
    "correctness",
    "freshness",
    "dependencies",
    "observed_at"
  ],
  "properties": {
    "component": {
      "type": "string",
      "minLength": 1
    },
    "startup": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "readiness": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "liveness": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "correctness": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "age_ms",
        "max_age_ms"
      ],
      "properties": {
        "age_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_age_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "evidence_ref": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "correctness": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "liveness": {
            "const": "PASS"
          }
        }
      }
    }
  ]
}
