{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doa-standard.org/schemas/capability-grant.schema.json",
  "title": "DOA CapabilityGrant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "capability",
    "resource",
    "issuer",
    "issued_at",
    "expires_at",
    "nonce",
    "intent",
    "revocable",
    "signature_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "object"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nonce": {
      "type": "string",
      "minLength": 8
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "revocable": {
      "const": true
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depth",
        "max_depth",
        "parent_grant_id"
      ],
      "properties": {
        "depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1
        },
        "parent_grant_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signature_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
