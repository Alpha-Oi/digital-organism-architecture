{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doa-standard.org/schemas/organ.schema.json",
  "title": "DOA Organ",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "responsibility",
    "interfaces",
    "dependencies",
    "slo",
    "resources",
    "security",
    "health",
    "failure_policy",
    "recovery",
    "owner"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "responsibility": {
      "type": "string",
      "minLength": 10
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "direction",
          "schema_ref"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "in",
              "out"
            ]
          },
          "schema_ref": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "slo": {
      "type": "object",
      "minProperties": 1
    },
    "resources": {
      "type": "object",
      "minProperties": 1
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "capabilities",
        "data_classes"
      ],
      "properties": {
        "identity": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "health": {
      "type": "object",
      "minProperties": 1
    },
    "failure_policy": {
      "enum": [
        "fail-closed",
        "fail-open-bounded",
        "degrade",
        "failover",
        "isolate",
        "terminate"
      ]
    },
    "critical": {
      "type": "boolean"
    },
    "redundancy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "active-active",
            "active-passive",
            "quorum",
            "graceful-degradation"
          ]
        },
        "min_replicas": {
          "type": "integer",
          "minimum": 1
        },
        "failure_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes",
        "source_of_truth",
        "rto",
        "rpo",
        "validation"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "RESTART",
              "RESTORE",
              "REPAIR",
              "REPLACE",
              "REGENERATE",
              "REBUILD",
              "RECONFIGURE",
              "ROLLBACK"
            ]
          }
        },
        "source_of_truth": {
          "type": "string"
        },
        "rto": {
          "type": "string"
        },
        "rpo": {
          "type": "string"
        },
        "validation": {
          "type": "string"
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "critical": {
            "const": true
          }
        },
        "required": [
          "critical"
        ]
      },
      "then": {
        "required": [
          "redundancy"
        ]
      }
    }
  ]
}
